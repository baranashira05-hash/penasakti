{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2017",
    "lib": ["ES2017"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "outDir": ".scripts-out"
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
